# Copy to .env on the server and fill in. NEVER commit the real .env.
# Run `npm run check-env` after editing: it reports missing/weak values without printing them.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
# Public site URL, used in email links (no trailing slash needed)
CLIENT_URL=https://arenax.io
# Comma-separated browser origins allowed to call the API (CORS)
ALLOWED_ORIGINS=https://arenax.io,https://www.arenax.io

# ─── Database (MySQL) ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=arenax

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d
# Comma-separated emails that get the admin dashboard. Without this nobody is admin.
ADMIN_EMAILS=you@example.com
# Secret for hashing IPs in the abuse-signal log. Set ONCE and do not change it
# later (changing it makes older IP hashes stop matching). Falls back to JWT_SECRET.
SIGNAL_HASH_SECRET=replace_with_another_long_random_secret

# ─── Email (Nodemailer: verification, password reset, redemption notices) ─────
# NOTE: the code reads SMTP_*, not EMAIL_*. Mail is silently disabled if these are missing.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your_smtp_password

# ─── PandaScore (auto-sync of featured/famous tournaments) ────────────────────
# Leave blank to disable the daily featured-tournament sync job.
PANDASCORE_API_KEY=

# ─── Razorpay (payments) ──────────────────────────────────────────────────────
# Keys: Razorpay dashboard > Account & Settings > API Keys.
# RAZORPAY_WEBHOOK_SECRET is set when you register the webhook URL
# (https://yourdomain.com/api/payments/webhook); it is NOT the API key secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
