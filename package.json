    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.2.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.22.4",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.7",
    "razorpay": "^2.9.8",
    "sanitize-html": "^2.13.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
