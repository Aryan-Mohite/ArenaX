{
  "name": "arenax",
  "version": "1.0.0",
  "description": "ArenaX eSports Platform — Hostinger Node.js deployment",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --env-file=.env server.js",
    "build:frontend": "node scripts/build-frontend.js",
