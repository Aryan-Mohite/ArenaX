# ─── Build output ───────────────────────────────────────────────────────────
# frontend/dist/ is INTENTIONALLY TRACKED, not ignored.
# GitHub Actions (.github/workflows/prerender-deploy.yml) builds + prerenders
# it with react-snap and commits it to main. Hostinger's auto-deploy then
# just serves the committed dist — see scripts/build-frontend.js.
frontend/dist-ssr/
frontend/.vite/
*.local

# ─── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
pids/
*.pid
*.seed
*.pid.lock

# ─── Testing / coverage ────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Editor / IDE ───────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

